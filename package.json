{
  "name": "nextjs-dev-pending-operations-repro",
  "private": true,
  "version": "0.0.1",
  "description": "Minimal Next.js dev-mode memory retention repro for RSC pendingOperations tracking",
  "scripts": {
    "dev": "NODE_OPTIONS='--require ./scripts/patch-next-dev-pending-operations.cjs --expose-gc' NEXT_TELEMETRY_DISABLED=1 next dev -p 8136 --inspect",
    "build": "next build",
    "start": "next start -p 8136",
    "repro:server-action": "REPRO_DRIVER=server-action node scripts/repro-loop.mjs",
    "repro:api": "REPRO_DRIVER=api node scripts/repro-loop.mjs",
    "repro:server-action:measure": "REPRO_DRIVER=server-action node scripts/repro-measure.mjs",
    "repro:server-action:get-only:measure": "REPRO_SERVER_ACTION_PHASE=get-only node scripts/repro-server-action-phase-measure.mjs",
    "repro:server-action:post-only:measure": "REPRO_SERVER_ACTION_PHASE=post-only node scripts/repro-server-action-phase-measure.mjs",
    "repro:api:measure": "REPRO_DRIVER=api node scripts/repro-measure.mjs",
    "repro:measure:status": "REPRO_MEASURE_ONLY=1 node scripts/repro-measure.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
